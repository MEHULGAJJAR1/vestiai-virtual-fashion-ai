# ======================================================================================
# VestiAI — environment template.  Copy to `.env` and edit.  (`.env` is git-ignored.)
#
#   cp .env.example .env
#
# Every value below overrides configs/default.yaml. Only uncomment what you need.
# ======================================================================================

# ------------------------------------------------------------------ server
# VESTIAI_HOST=0.0.0.0
# VESTIAI_PORT=8000
# VESTIAI_DEBUG=false
# VESTIAI_LOG_LEVEL=INFO
# VESTIAI_CORS_ORIGINS=*

# ------------------------------------------------------------------ device
# auto | cuda | mps | cpu
# VESTIAI_DEVICE=auto
# VESTIAI_FORCE_CPU=false
# VESTIAI_MIN_GPU_MEMORY_GB=6

# ------------------------------------------------------------------ try-on
# auto | diffusion | lightweight | disabled
# VESTIAI_TRYON_BACKEND=auto
# VESTIAI_RESOLUTION=512
# VESTIAI_NUM_INFERENCE_STEPS=30
# VESTIAI_GUIDANCE_SCALE=2.0
# VESTIAI_LIVE_AI_INTERVAL_MS=700
# Allow diffusion on a CPU-only machine (roughly one minute per image):
# VESTIAI_ENABLE_CPU_DIFFUSION=false
# Base diffusion checkpoint used by the trainer + exporter:
# VESTIAI_VTON_BASE_PIPELINE=stabilityai/stable-diffusion-2-inpainting
# Use the SD-1.5 inpainting base (smaller download, works on 8 GB GPUs):
# VESTIAI_VTON_BASE_PIPELINE=stable-diffusion-v1-5/stable-diffusion-inpainting

# ------------------------------------------------------------------ garment preprocessing
# auto | rembg | grabcut | none
# VESTIAI_BACKGROUND_REMOVAL=auto

# ------------------------------------------------------------------ training
# VESTIAI_TRAINING_MODE=QUICK_DEMO
# VESTIAI_BATCH_SIZE=2
# VESTIAI_NUM_EPOCHS=10
# VESTIAI_LEARNING_RATE=0.00001
# VESTIAI_MIXED_PRECISION=fp16        # auto | fp16 | bf16 | no
# VESTIAI_TRACKER=tensorboard         # tensorboard | wandb | none
# VESTIAI_SAMPLE_DATA_MODE=true

# ------------------------------------------------------------------ optional services
# Hugging Face token — required for gated base models, and for pushing checkpoints:
# HF_TOKEN=hf_xxx
# Weights & Biases (only if VESTIAI_TRACKER=wandb):
# WANDB_API_KEY=xxx
# WANDB_PROJECT=vestiai
# TensorBoard log dir override:
# VESTIAI_TENSORBOARD_DIR=logs/tensorboard
